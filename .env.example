
# OCR: PDF -> văn bản
OCR_ENDPOINT=http://localhost:8001/v1/ocr/documents
OCR_TIMEOUT=900


# LLM (OpenAI-compatible): văn bản -> giao việc
OPENAI_BASE_URL=http://localhost:8000/v1
MODEL_NAME=local-llm
OPENAI_API_KEY=EMPTY
LLM_TEMPERATURE=0


# llama.cpp self-host
LLM_HF_REPO=unsloth/Qwen3.5-9B-GGUF
LLM_HF_FILE=Qwen3.5-9B-Q4_K_M.gguf
LLM_CTX_SIZE=32768
LLM_REASONING_BUDGET=1024
LLM_THREADS=6
LLM_CPUSET=0-11
LLM_SLEEP_IDLE_SECONDS=60
LLM_MODELS_DIR=./models

# OCR self-host (PaddleOCR-VL-1.6, chạy CPU)
OCR_VL_THREADS=8
OCR_CPUSET=12-19
OCR_MODELS_DIR=./models/paddlex

# API
API_PORT=8080
# CORS_ORIGINS=http://localhost:3000

# Giả lập máy thường trên server lớn (xem README): giới hạn RAM từng service, 0 = không giới hạn
# LLM_MEM_LIMIT=9g
# OCR_VL_MEM_LIMIT=4g
# OCR_MEM_LIMIT=4g
# MAX_CONCURRENT_JOBS=1
# MAX_QUEUED_JOBS=20
# JOB_TTL_SECONDS=86400
