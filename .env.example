# OCR API: PDF -> văn bản
OCR_ENDPOINT=https://<ocr-host>/v1/ocr/documents
OCR_TIMEOUT=900

# LLM (OpenAI-compatible): văn bản -> giao việc
# Khi chạy bằng docker compose, summarizer tự trỏ tới container llm (http://llm:8000/v1)
OPENAI_BASE_URL=http://localhost:8000/v1
MODEL_NAME=local-llm
OPENAI_API_KEY=
LLM_TEMPERATURE=0
# llama.cpp self-host (docker compose): model GGUF trên Hugging Face, độ dài context
# LLM_HF_REPO=unsloth/Qwen3.5-9B-GGUF
# LLM_HF_FILE=Qwen3.5-9B-Q4_K_M.gguf
# LLM_CTX_SIZE=32768
# Thư mục lưu weight GGUF trên host (tải 1 lần, dùng lại)
# LLM_MODELS_DIR=./models
# Retry khi lỗi kết nối (reset by peer) / 429 / 5xx: số lần thử lại, backoff (giây)
# LLM_MAX_RETRIES=3
# LLM_BACKOFF_BASE=2
# LLM_BACKOFF_MAX=30

# Knowledge base để suy luận đơn vị cho nhiệm vụ gián tiếp (mặc định: knowledge_base.json)
# KB_PATH=knowledge_base.json

# Cổng host của API khi chạy docker compose (mặc định 8080)
# API_PORT=8080

# CORS: các origin được phép gọi API, cách nhau bởi dấu phẩy (mặc định: *)
# CORS_ORIGINS=http://localhost:3000,https://app.example.com
