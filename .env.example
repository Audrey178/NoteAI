
# LLM (OpenAI-compatible): văn bản -> giao việc
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Model mặc định; client có thể chọn model khác qua trường `model` của /v1/tasks (xem GET /v1/models)
MODEL_NAME=DeepSeek-V4.1-Flash
LLM_TEMPERATURE=0
# Retry khi lỗi kết nối (reset by peer) / 429 / 5xx: số lần thử lại, backoff (giây)
# LLM_MAX_RETRIES=3
# LLM_BACKOFF_BASE=2
# LLM_BACKOFF_MAX=30

# OCR: trong Docker đã cấu hình sẵn ở docker-compose.yml; chạy local thì điền vào đây
# OCR_ENDPOINT=http://localhost:8085/v1/ocr/documents

# Knowledge base để suy luận đơn vị cho nhiệm vụ gián tiếp (mặc định: knowledge_base.json)
# KB_PATH=knowledge_base.json

# CORS: các origin được phép gọi API, cách nhau bởi dấu phẩy (mặc định: *)
# CORS_ORIGINS=http://localhost:3000,https://app.example.com
