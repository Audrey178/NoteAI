
# OCR: PDF -> văn bản
OCR_ENDPOINT=http://localhost:8001/v1/ocr/documents
OCR_TIMEOUT=900


# LLM (OpenAI-compatible): văn bản -> giao việc
OPENAI_BASE_URL=http://localhost:8000/v1
MODEL_NAME=local-llm
OPENAI_API_KEY=EMPTY
LLM_TEMPERATURE=0


# llama.cpp self-host
LLM_HF_REPO=unsloth/Qwen3.5-9B-GGUF
LLM_HF_FILE=Qwen3.5-9B-Q4_K_M.gguf
LLM_CTX_SIZE=32768
LLM_REASONING_BUDGET=1024
LLM_THREADS=6
LLM_CPUSET=0-11
LLM_SLEEP_IDLE_SECONDS=60
LLM_MODELS_DIR=./models

# OCR self-host (PaddleOCR-VL-1.6, chạy CPU)
OCR_VL_THREADS=8
OCR_CPUSET=12-19
OCR_MODELS_DIR=./models/paddlex

# API
API_PORT=8080
# CORS_ORIGINS=http://localhost:3000
